{
  "experiment": "paper1.2",
  "paper": "../papers/paper1/paper1.pdf",
  "dataset": "../datasets/ETTh1.csv",
  "author": {
    "url": "https://github.com/cure-lab/LTSF-Linear.git",
    "ref": "main"
  },
  "codex_version": "0.160.1",
  "stage_timeout_seconds": 7200,
  "protocol": {
    "dataset": "ETTh1",
    "models": [
      "Linear",
      "NLinear",
      "DLinear"
    ],
    "lookback": 336,
    "horizon": 96,
    "features": [
      "HUFL",
      "HULL",
      "MUFL",
      "MULL",
      "LUFL",
      "LULL",
      "OT"
    ],
    "split": {
      "train_end": 8640,
      "validation_end": 11520,
      "test_end": 14400
    },
    "standardization": "per-channel training mean and population standard deviation",
    "seed": 42,
    "training": {
      "optimizer": "Adam",
      "learning_rate": 0.001,
      "batch_size": 64,
      "max_epochs": 50,
      "patience": 5,
      "schedule": "constant",
      "checkpoint_selection": "lowest validation MSE",
      "training_shuffle": true,
      "drop_last": false
    },
    "evaluation": {
      "units": "standardized",
      "metrics": [
        "mse",
        "mae"
      ],
      "stride": 1,
      "all_test_windows": true,
      "test_only_after_selection": true
    }
  }
}
